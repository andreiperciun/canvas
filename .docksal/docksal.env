# Docksal project configuration.
# Docs: https://docs.docksal.io/stack/settings/

DOCKSAL_STACK=default

# Web root, relative to the project root.
DOCROOT=docroot

VIRTUAL_HOST=canvas.docksal.site

# PHP 8.4 - recommended for Drupal 11.4.x.
CLI_IMAGE=docksal/cli:php8.4-3
WEB_IMAGE=docksal/nginx:1.21-1.2
DB_IMAGE=docksal/mariadb:10.11-1.5

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=default
MYSQL_USER=user
MYSQL_PASSWORD=user

XDEBUG_ENABLED=0
